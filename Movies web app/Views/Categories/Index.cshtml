@using Business.DTOs.Categories
@model List<GetAllCategoriesDto>
@{
    ViewData["Title"] = "Categories";
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";
    ViewData["AdminPageIcon"] = "fas fa-tags";
    ViewData["AdminPageSubtitle"] = "Manage movie categories.";
}


<div class="container">

<div class="row d-flex justify-content-center">
<table class="table table-striped text-white w-50">
<tr class="text-white">
<th><i class="fas fa-hashtag"></i> #</th>
<th><i class="fas fa-tag"></i> Name</th>
<th><i class="fas fa-cogs"></i> Actions</th>
</tr>
@foreach (var item in Model)
{
<tr class="text-white">
<td>
<i class="fas fa-layer-group"></i> @item.Id
</td>
<td>
<i class="fas fa-tags"></i> @item.Name
</td>
<td class="col-6">
<a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-success rounded rounded-circle" title="Edit">
<i class="fas fa-pencil-alt"></i>
</a>
<a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger rounded rounded-circle" title="Delete" 
onclick="return confirm('Are you sure you want to delete category @item.Name?')">
<i class="fas fa-trash"></i>
</a>
</td>
</tr>
}
</table>
</div>
</div>
<div style="position:fixed; bottom: 20px; right: 20px">
<a asp-action="Create" class="btn btn-outline-success rounded rounded-circle shadow-lg" title="Add New Category">
<i class="fas fa-plus-circle" style="font-size: 1.5rem;"></i>
</a>
</div>
