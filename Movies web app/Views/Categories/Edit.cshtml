@using Business.DTOs.Categories
@model UpdateCategoryDto

@{
    ViewData["Title"] = "Edit Category";
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";
    ViewData["AdminPageIcon"] = "fas fa-tag";
    ViewData["AdminPageSubtitle"] = "Update movie category details.";
}

<div class="row text">
    <div class="col-md-8 offset-2">
        <h1 class="text-white">
            Edit Category
        </h1>
    </div>
    <div class="col-md-8 offset-2">

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group text-white">
                <label asp-for="Name" class="control-label">Full Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter Category Name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group text-white">
                <label asp-for="Description" class="control-label">Description</label>
                <textarea asp-for="Description" class="form-control" placeholder="Enter category description"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-between mb-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                <input type="submit" value="Update" class="btn btn-outline-success" />
            </div>
        </form>
    </div>


</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
