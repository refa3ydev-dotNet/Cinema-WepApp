@model IEnumerable<Business.DTOs.Cinemas.GetAllCinemasDto>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cinema Registration Requests";
    ViewData["AdminPageTitle"] = "Pending Approvals";
    ViewData["AdminPageIcon"] = "fas fa-file-signature";
    ViewData["ActiveAdminPage"] = "approvals";
}
<link href="~/css/Cinemas/Pending_Cinema.css" rel="stylesheet" asp-append-version="true" />

<div class="container mt-5 mb-5 pt-5 " style="margin-top: 50px;">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="fas fa-file-signature"></i> Cinema Registration Requests
            </h1>
            <p class="subtitle">Review and manage new cinema onboarding applications</p>
        </div>
    </div>

    <div class="glass-container">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-glass-cheers"></i>
                <h3>Great Job!</h3>
                <p>No pending cinema registration requests at the moment. You're all caught up!</p>
            </div>
        }
        else
        {
            <div class="requests-list">
                @foreach (var cinema in Model)
                {
                    <div class="request-card">
                        <div class="cinema-logo-wrapper">
                            <img src="@cinema.LogoPath" alt="@cinema.Name">
                        </div>

                        <div class="cinema-info">
                            <div class="info-group">
                                <h3 class="cinema-name">@cinema.Name</h3>
                                <div class="info-value"><i class="fas fa-user-tie"></i> @cinema.AgentName</div>
                            </div>

                            <div class="info-group">
                                <span class="info-label">Location</span>
                                <div class="info-value"><i class="fas fa-map-marker-alt"></i> @cinema.Address</div>
                            </div>

                            <div class="info-group">
                                <span class="info-label">Request Date</span>
                                <div class="info-value"><i class="far fa-calendar-alt"></i> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>

                        <div class="actions-wrapper">
                            <form asp-action="ApproveCinema" asp-controller="Admin" class="d-inline" method="post">
                                <input type="hidden" name="id" value="@cinema.Id" />
                                <button type="submit" class="btn-action btn-approve" data-tooltip="Approve Request">
                                    <i class="fas fa-check"></i>
                                </button>
                            </form>

                            <button type="button" class="btn-action btn-reject" data-bs-toggle="modal" data-bs-target="#rejectModal-@cinema.Id" data-tooltip="Reject Request">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (Model.Any())
{
    foreach (var cinema in Model)
    {
        <div class="modal fade" id="rejectModal-@cinema.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content text-dark" style="border-radius: 15px; overflow: hidden;">
                    <div class="modal-header bg-light">
                        <h5 class="modal-title text-danger fw-bold"><i class="fas fa-exclamation-triangle"></i> Reject Cinema Request</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <form asp-action="RejectCinema" asp-controller="Admin" method="post">
                        <div class="modal-body p-4">
                            <input type="hidden" name="id" value="@cinema.Id" />

                            <p>You are about to reject the request for <strong>@cinema.Name</strong>.</p>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Reason for Rejection (Visible to Agent):</label>
                                <textarea name="reason" class="form-control" rows="3" required placeholder="e.g., The commercial register document is expired or unclear. Please upload a valid document."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger px-4">Confirm Rejection</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
