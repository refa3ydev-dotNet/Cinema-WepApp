@using Business.DTOs.Movies
@using Core.Helpers
@using System.Linq
@model PaginationResult<GetAllMoviesDto>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Cinemas";

}
@section Styles {
    <link rel="stylesheet" href="~/css/Movie/Movies.css" />
}
<div class="container">
    <div class="row align-content-center d-flex justify-content-center gap-4">
        @if (Model.Items.Count > 0)
        {

            @foreach (var movie in Model.Items)
            {
                <div class="card-movie p-0">
                <a  asp-action="Details" asp-route-id="@movie.Id" class="text-white">
                    <img src="@Html.DisplayFor(modelItem => movie.PosterUrl)" alt="">
                    <div class="info">
                        <div class="bottom">
                            <h3 class="text-white">@Html.DisplayFor(modelItem => movie.Name)</h3>
                            <table>
                                <tr class="text-white">
                                    <td><span class="title">Movie Name : </span></td>
                                    <td>@Model.Items.FirstOrDefault().Name</td>

                                </tr>
                                <tr class="text-white">
                                    <td><span class="title">Price:</span></td>
                                    <td>@movie.Price.ToString("c")</td>
                                </tr>

                            </table>


                        </div>

                    </div>
                </a>
                </div> 
            }
        }
        else
        {
            <h1 class="text-white">No Movies Found</h1>
        }
    </div>

</div>
<div class="pagination">
    @if (Model.CurrentPage > 1)
    {
        <a href="?page=@(Model.CurrentPage - 1)">Previous</a>
    }

    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        if (i == Model.CurrentPage)
        {
            <strong>@i</strong>
        }
        else
        {
            <a href="?page=@i">@i</a>
        }
    }

    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a href="?page=@(Model.CurrentPage + 1)">Next</a>
    }
</div>
<div style="position:fixed; bottom: 20px; right: 20px">

    <a asp-action="Create" class="btn btn-outline-success rounded-circle rounded"><i class="bi bi-plus-circle-fill"></i></a>
</div>