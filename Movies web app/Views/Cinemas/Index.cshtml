@using Business.DTOs.Cinemas
@using Core.Helpers
@using System.Linq
@model PaginationResult<GetAllCinemasDto>

@{
    if (!User.IsInRole("Admin"))
    {

        Layout = "_Layout";
        ViewData["Title"] = "Cinemas";
    }
    else
    {
        Layout = "_AdminLayout";
        ViewData["Title"] = "Cinemas";
        ViewData["AdminPageIcon"] = "fas fa-building";
        ViewData["AdminPageSubtitle"] = "Manage registered cinemas.";
    }
}

<link href="~/css/Cinemas/Cinema.css" rel="stylesheet" asp-append-version="true"/>
@* <h1 class="text-danger text-center mt-5">Welcome in <span class="h1">Cinema</span> page</h1>
<div class="row text-white">
    <div class="box row">
        @foreach (var item in Model.Items)
        {
            <a asp-controller="Cinemas" asp-action="Details" asp-route-id="@item.Id">

                <div class="card">
                    <div class="imgBx">
                        <img src="@item.LogoPath" alt="@item.Name">
                    </div>
                    <div class="details">
                        <h2>@item.Name<br><span>Cinema</span></h2>
                    </div>
                </div>
            </a>
        }
    </div>
</div>

<div style="position:fixed; bottom: 20px; right: 20px">

    <a asp-action="Create" class="btn btn-outline-success rounded rounded-circle "><i class="bi bi-plus-circle-fill"></i></a>
</div>
<div class="pagination d-flex justify-content-center">
    <nav aria-label="Pagination">
        <ul class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.CurrentPage - 1)">Previous</a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                if (i == Model.CurrentPage)
                {
                    <li class="page-item active">
                        <a class="page-link" href="?page=@i">@i <span class="sr-only"></span></a>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" href="?page=@i">@i</a>
                    </li>
                }
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.CurrentPage + 1)">Next</a>
                </li>
            }
        </ul>
    </nav>

</div> *@
<!-- Hero Section -->
<section class="cinemas-hero">
    <div class="hero-content">
        <h1>Discover Our <br><span class="highlight">Locations</span></h1>
        <p>Find the nearest cinema and experience the magic of movies in our premium theaters equipped with Dolby Atmos and IMAX.</p>

        <div class="cinema-search-container">
            <div class="search-icon-wrapper"><i class="fas fa-search"></i></div>
            <input type="text" class="cinema-search-input" placeholder="Search cinemas by name or city...">
            <button class="btn-search-pill">Search</button>
        </div>
    </div>
</section>

<!-- Cinemas List Section -->
<section class="cinemas-section">
    <div class="cinemas-header">
        <div class="header-left">
            <h2>All Cinemas</h2>
            <p>Showing 6 locations nearby</p>
        </div>

        <div class="header-actions">
            <a asp-action="Create" class="btn-add-cinema" style="text-decoration:none;"><i class="fas fa-plus"></i> Add New Cinema</a>
        </div>
    </div>

    <!-- Cinemas Grid -->
    <div class="cinemas-grid">
        <!-- Card 1: Grand Central -->
        @foreach (var item in Model.Items)
        {
            
        <div class="cinema-card">
            <div class="card-image-container">
                <img src="@item.BackgroundPath" alt="@item.Name">
                <div class="rating-badge"><i class="fas fa-star"></i> 4.8</div>
            </div>
            <div class="card-content">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h3>@item.Name</h3>
                    <div class="card-icons gap-2 d-flex">
                        <i class="fas fa-video"></i>
                        <i class="fas fa-volume-up"></i>
                    </div>
                </div>
                <div class="card-location">
                        <i class="fas fa-map-marker-alt position-relative mt-1" ></i> @item.Address
                </div>
                <p class="card-description">
                        @(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                </p>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn-card-action" style="display:block; text-align:center; text-decoration:none;">View Details</a>
            </div>
        </div>
        }

    </div>

    <!-- Pagination (Visual) -->
    @if(Model.TotalPages > 1)
    {
        
    <div class="pagination">
        <button class="page-arrow"><i class="fas fa-chevron-left"></i></button>
        <a href="#" class="page-link active">1</a>
        <a href="#" class="page-link">2</a>
        <a href="#" class="page-link">3</a>
        <span style="color: grey;">...</span>
        <a href="#" class="page-link">8</a>
        <button class="page-arrow"><i class="fas fa-chevron-right"></i></button>
    </div>
    }
</section>


