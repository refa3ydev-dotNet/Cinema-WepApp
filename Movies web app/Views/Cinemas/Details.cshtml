@using Business.DTOs.Cinemas
@model GetCinemaByIdDto

@{
    ViewData["Title"] = "Details";
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";
    ViewData["AdminPageTitle"] = Model.Name;
    ViewData["AdminPageIcon"] = "fas fa-building";
    ViewData["AdminPageSubtitle"] = "Review cinema profile details.";

    var BackgroundPath = Model.BackgroundPath;
}

<link href="~/css/Cinemas/Cinema.css" rel="stylesheet" asp-append-version="true"/>

<!-- Cinema Details Hero -->
<section class="details-hero">
    <!-- BackgroundPath -->
    <img src="@Model.BackgroundPath" alt="@Model.Name, Background" class="details-hero-img">
    <div class="details-hero-overlay">
        <div class="details-hero-content">
            <!-- Top Header Row -->
            <div class="details-hero-header">
                <div class="details-title-area">
                    <div class="details-badge-row">
                        <span class="status-badge">OPEN NOW</span>
                    </div>
                    <div class="details-title" style="display: flex; align-items: center; gap: 1.5rem;">
                        <!-- LogoPath -->
                        <img src="@Model.LogoPath"
                             alt="@Model.Name, Logo"
                             style="width: 100px; height: 100px; object-fit: contain; border-radius: 50%; background: white; box-shadow: 0 4px 15px rgba(0,0,0,0.3);"
                             class="cinema-logo">
                        <!-- Name -->
                        <h1>@Model.Name</h1>
                    </div>
                </div>
                <div class="details-actions">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-hero-secondary" style="text-decoration: none;">
                        <i class="fas fa-edit"></i> Edit Cinema
                    </a>
                    <button class="btn-hero-primary"><i class="fas fa-ticket-alt"></i> View Schedule</button>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Separated Description Area -->
<section class="cinema-description-section">
    <div class="details-hero-description">
        <div class="read-more-container">
            <input type="checkbox" id="readMoreToggle" class="read-more-toggle">
            <div class="description-content">
                <!-- The dynamic @Model.Description text wraps seamlessly inside here -->
                <p class="details-subtitle">
                    @Model.Description
                </p>
            </div>
            <label for="readMoreToggle" class="read-more-btn" data-read-more="Read More"
                   data-read-less="Show Less"></label>
        </div>
    </div>
</section>

<!-- Glassmorphism Info Grid -->
<section class="details-grid">
    <!-- Location Card -->
    <div class="glass-card">
        <div class="info-icon-large">
            <i class="fas fa-map-marker-alt"></i>
        </div>
        <h4>Location</h4>
        <!-- Address -->
        <p>@Model.Address</p>
        <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(@Model.Address)" target="_blank" rel="noopener noreferrer" class="btn-text-link">Get Directions <i class="fas fa-arrow-right"></i></a>
    </div>

    <!-- Contact Card -->
    <div class="glass-card">
        <div class="info-icon-large">
            <i class="fas fa-phone-alt"></i>
        </div>
        <h4>Contact & Hours</h4>
        <p>Box Office: (555) 123-4567<br>Open Daily: 10:00 AM - 2:00 AM</p>
        <a href="#" class="btn-text-link">Call Cinema <i class="fas fa-arrow-right"></i></a>
    </div>

    <!-- Map Card -->
    <div class="glass-card map-card-container" style="padding: 0; overflow: hidden; position: relative;">
        @if (!string.IsNullOrEmpty(Model.Address))
        {
            <iframe src="https://maps.google.com/maps?q=@Uri.EscapeDataString(Model.Address)&t=&z=15&ie=UTF8&iwloc=&output=embed"
                    width="100%" height="100%" style="border:0; position: absolute; inset: 0;" allowfullscreen=""
                    loading="lazy" referrerpolicy="no-referrer-when-downgrade">
            </iframe>
        }
        else
        {
            <div style="display:flex; justify-content:center; align-items:center; height:100%; width:100%; background:#eee; color:#888; position: absolute; inset: 0;">
                <p>No Address</p>
            </div>
        }
        <button class="btn-map-float" style="pointer-events: none;">Open Map</button>
    </div>
</section>
