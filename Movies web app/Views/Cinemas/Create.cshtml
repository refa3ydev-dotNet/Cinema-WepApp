@using Business.DTOs.Cinemas
@model CreateCinemaDto

@{
    ViewData["Title"] = "Create New Cinema";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="/css/Cinemas/Cinema.css" rel="stylesheet" asp-append-version="true"/>
@* @* 
<div class="row text">
    <div class="col-md-8 offset-2">
        <h1 class="text-white">
            Add a New Cinema
        </h1>
    </div>
    <div class="col-md-8 offset-2">

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group text-center">
                <img id="ProfilePicturePreview" style="max-width: 200px; height: auto;" />
            </div>
            <div class="form-group text-white">
                <label asp-for="Logo" class="control-label">Logo </label>
                <input asp-for="Logo" class="form-control" id="ProfilePictureURL" placeholder="" type="file" />
                <span asp-validation-for="Logo" class="text-danger"></span>
            </div>
            <div class="form-group text-white">
                <label asp-for="BackgroundPicture" class="control-label">BackgroundPicture </label>
                <input asp-for="BackgroundPicture" class="form-control" id="BackgroundPicture" placeholder="" type="file" />
                <span asp-validation-for="BackgroundPicture" class="text-danger"></span>
            </div>
            <div class="form-group text-white">
                <label asp-for="Name" class="control-label">Name</label>
                <input asp-for="Name" class="form-control" placeholder="" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group text-white">
                <label asp-for="Description" class="control-label">Description</label>
                <input asp-for="Description" class="form-control" placeholder="" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group text-white">
                <label asp-for="Address" class="control-label">Address</label>
                <input asp-for="Address" class="form-control" placeholder="" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-between mb-2 mt-2">
                <input type="submit" value="Create" class="btn btn-outline-success" />
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>


</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Add the following code if you want the name of the file appear on select
        $(".custom-file-input").on("change", function () {
            var fileName = $(this).val().split("\\").pop();
            $(this).siblings(".custom-file-label").addClass("selected").html(fileName);
        });
    </script>
    <script>

        $("#ProfilePictureURL").on("change", function () {
            const [file] = this.files;
            if (file) {
                const output = document.getElementById("ProfilePicturePreview");
                output.src = URL.createObjectURL(file);
            }
        });
    </script>

        } *@ 


<section class="admin-section">
    <div class="admin-container">
        <div class="admin-header">
            <div class="admin-breadcrumbs">
                <a asp-contriller="Home" asp-action="Index" ><i class="fas fa-home"></i> Home</a>
                <i class="fas fa-chevron-right separator"></i>
                <a asp-action="Index">Cinemas</a>
                <i class="fas fa-chevron-right separator"></i>
                <span>Create Cinema</span>
            </div>
            <h1>Add New Cinema</h1>
            <p>Enter the details below to register a new venue in the system.</p>
        </div>

        <div class="admin-form-wrapper">
            <div class="admin-form-header">
                <a href="cinemas.html" class="btn-back"><i class="fas fa-arrow-left"></i> Back to List</a>
            </div>

            <form asp-action="Create" method="post" class="admin-form" enctype="multipart/form-data">

                <!-- Cover Image Upload -->
                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <label>Cinema Cover Image (BackgroundPicture)</label>
                        <div class="input-type-toggle">
                            <div class="toggle-option active" onclick="toggleInput('cover', 'file', this)">
                                <i class="fas fa-cloud-upload-alt"></i> Upload
                            </div>
                            <div class="toggle-option" onclick="toggleInput('cover', 'url', this)">
                                <i class="fas fa-link"></i> URL
                            </div>
                        </div>
                    </div>

                    <div id="cover-file-container">
                        <div class="file-upload-box">
                            <i class="fas fa-cloud-upload-alt icon-upload"></i>
                            <h3>Click or Drag to Upload</h3>
                            <p>SVG, PNG, JPG or GIF (max. 800x400px)</p>
                            <input type="file" id="backgroundPicture" asp-for="BackgroundPicture" accept="image/*">
                        </div>
                    </div>

                    <div id="cover-url-container" class="url-input-container">
                        <input asp-for="BackgroundPath" type="url" class="form-control" placeholder="https://example.com/cover-image.jpg" oninput="previewUrl('cover', this)">
                        <div class="url-preview-box" id="cover-url-preview">
                            <div class="preview-placeholder">
                                <i class="fas fa-image"></i>
                                <span class="placeholder-text">Image Preview</span>
                            </div>
                            <img src="" alt="Preview">
                        </div>
                    </div>
                </div>

                <!-- Logo Upload -->
                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <label>Cinema Logo (Logo)</label>
                        <div class="input-type-toggle">
                            <div class="toggle-option active" onclick="toggleInput('logo', 'file', this)">
                                <i class="fas fa-cloud-upload-alt"></i> Upload
                            </div>
                            <div class="toggle-option" onclick="toggleInput('logo', 'url', this)">
                                <i class="fas fa-link"></i> URL
                            </div>
                        </div>
                    </div>

                    <div id="logo-file-container">
                        <div class="file-upload-box small-upload">
                            <i class="fas fa-image icon-upload"></i>
                            <h3>Upload Logo</h3>
                            <input type="file" id="logo" asp-for="Logo" accept="image/*">
                        </div>
                    </div>

                    <div id="logo-url-container" class="url-input-container">
                        <input type="url" class="form-control" asp-for="LogoPath" placeholder="https://example.com/logo.png" oninput="previewUrl('logo', this)">
                        <div class="url-preview-box small-preview" id="logo-url-preview">
                            <div class="preview-placeholder">
                                <i class="fas fa-image"></i>
                                <span class="placeholder-text">Logo Preview</span>
                            </div>
                            <img src="" alt="Preview">
                        </div>
                    </div>
                </div>

                <!-- Cinema Name -->
                <div class="form-group">
                    <label for="name">Cinema Name</label>
                    <input type="text" id="name" asp-for="Name" placeholder="e.g. Grand Cinema Hall" class="form-control">
                </div>

                <!-- Description -->
                <div class="form-group">
                    <label asp-for="Description">Description</label>
                    <textarea id="description" asp-for="Description" rows="4" placeholder="Enter a brief description of the venue, amenities, and history..." class="form-control"></textarea>
                </div>

                <!-- Address -->
                <div class="form-group">
                    <label asp-for="Address">Address</label>
                    <input type="text" id="address" asp-for="Address" placeholder="e.g. 123 Movie Blvd, Los Angeles, CA 90001" class="form-control">
                </div>

                <!-- Actions -->
                <div class="form-actions">
                    <a asp-action="Index" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn-create-submit"><i class="fas fa-check"></i> Create Cinema</button>
                </div>

            </form>
        </div>
    </div>
</section>

<script>
    // Simple script to handle visual feedback on file upload
    const uploadBoxes = document.querySelectorAll('.file-upload-box');

    uploadBoxes.forEach(box => {
        const input = box.querySelector('input[type="file"]');

        // Fixed: Removed the box click listener because the input already covers the entire box (100% width/height)
        // and handles the click natively. The previous listener caused the file dialog to open twice.

        // Ensure input is always on top for re-clicking
        input.style.zIndex = '10';

        // Add pulse animation on click
        input.addEventListener('click', () => {
            box.classList.remove('click-pulse');
            void box.offsetWidth; // trigger reflow
            box.classList.add('click-pulse');
        });

        input.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
                const file = e.target.files[0];
                const fileName = file.name;
                const h3 = box.querySelector('h3');

                // Update text
                h3.textContent = fileName;
                box.style.borderColor = '#e50914';
                box.style.background = 'rgba(229, 9, 20, 0.05)';

                // Image Preview Logic
                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();

                    reader.onload = (e) => {
                        // Clear existing content to show image
                        // We keep the input to allow re-selection

                        // Check if preview already exists
                        let img = box.querySelector('.preview-img');

                        if (!img) {
                            // Create new image element
                            img = document.createElement('img');
                            img.className = 'preview-img';
                            img.style.width = '100%';
                            img.style.height = '100%';
                            img.style.objectFit = 'cover';
                            img.style.borderRadius = '10px';
                            img.style.position = 'absolute';
                            img.style.top = '0';
                            img.style.left = '0';
                            img.style.zIndex = '1';
                            img.style.pointerEvents = 'none'; // Ensure clicks pass through

                            // Hide default icon and text but keep them in DOM
                            const icon = box.querySelector('.icon-upload');
                            const text = box.querySelector('h3');
                            const subtext = box.querySelector('p');

                            if(icon) icon.style.opacity = '0';
                            if(text) text.style.opacity = '0';
                            if(subtext) subtext.style.opacity = '0';

                            box.appendChild(img);
                        }

                        img.src = e.target.result;
                    };

                    reader.readAsDataURL(file);
                }
            }
        });
    });

    // Toggle Input File / URL
    function toggleInput(section, type, element) {
        // Update Toggle Button State
        const container = element.parentElement;
        const options = container.querySelectorAll('.toggle-option');
        options.forEach(opt => opt.classList.remove('active'));
        element.classList.add('active');

        // Target Containers
        const fileContainer = document.getElementById(section + '-file-container');
        const urlContainer = document.getElementById(section + '-url-container');
        const fileInput = fileContainer.querySelector('input[type="file"]');
        const urlInput = urlContainer.querySelector('input[type="url"]');

        if (type === 'file') {
            fileContainer.style.display = 'block';
            urlContainer.style.display = 'none';

            // Clear URL input
            urlInput.value = '';
            previewUrl(section, urlInput); // Reset preview
        } else {
            fileContainer.style.display = 'none';
            urlContainer.style.display = 'block';

            // Clear File input
            fileInput.value = '';

            // Reset Visuals for File Box (Remove Preview Image if any)
            const fileBox = fileContainer.querySelector('.file-upload-box');
            const img = fileBox.querySelector('.preview-img');
            if(img) img.remove();

            // Restore default text & styles
            const h3 = fileBox.querySelector('h3');
            if(h3) {
                 h3.textContent = section === 'cover' ? 'Click or Drag to Upload' : 'Upload Logo';
                 h3.style.opacity = '1';
            }
            const icon = fileBox.querySelector('.icon-upload');
            if(icon) icon.style.opacity = '1';
            const p = fileBox.querySelector('p');
            if(p) p.style.opacity = '1';

            fileBox.style.borderColor = 'rgba(255, 255, 255, 0.15)';
            fileBox.style.background = 'rgba(255, 255, 255, 0.02)';
        }
    }

    // URL Image Preview Logic
    function previewUrl(section, input) {
        const url = input.value;
        const previewBox = document.getElementById(section + '-url-preview');
        const img = previewBox.querySelector('img');
        const placeholderBox = previewBox.querySelector('.preview-placeholder');
        const placeholderText = previewBox.querySelector('.placeholder-text');
        const logoIcon = previewBox.querySelector('.fa-image');

        if (url && url.length > 8) { // Basic length check
            img.src = url;

            img.onload = () => {
                previewBox.classList.add('has-image');
                previewBox.classList.remove('error');
                // CSS handles opacity of placeholder

                // Reset Error State if it was there
                if(logoIcon) logoIcon.className = 'fas fa-image';
            };

            img.onerror = () => {
                previewBox.classList.remove('has-image');
                previewBox.classList.add('error');

                if(placeholderText) {
                    placeholderText.textContent = 'Invalid Image URL';
                    placeholderText.style.color = '#ff4444';
                }
                if(logoIcon) logoIcon.className = 'fas fa-exclamation-circle'; // Change icon to error
                if(logoIcon) logoIcon.style.color = '#ff4444';
                if(logoIcon) logoIcon.style.opacity = '0.5';
            };
        } else {
            img.src = ''; // Clear source
            previewBox.classList.remove('has-image');
            previewBox.classList.remove('error');

            if(placeholderText) {
                placeholderText.textContent = section === 'cover' ? 'Image Preview' : 'Logo Preview';
                placeholderText.style.color = ''; // Reset color
            }
            if(logoIcon) {
                logoIcon.className = 'fas fa-image';
                logoIcon.style.color = '';
                logoIcon.style.opacity = '0.2';
            }
        }
    }
</script>