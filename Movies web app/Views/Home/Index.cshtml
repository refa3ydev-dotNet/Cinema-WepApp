@{
    ViewData["Title"] = "Home Page";
}
<link href="~/css/Home.css" rel="stylesheet" />
<section class="hero-carousel">
    <div class="carousel-track-container">
        <ul class="carousel-track">
            <!-- Slide 1: Dune -->
            <li class="carousel-slide current-slide" data-bg="assets/hero_bg.png">
                <div class="slide-overlay"></div>
                <div class="slide-content">
                    <div class="badge-container">
                        <span class="badge">NOW SHOWING</span>
                        <span class="rating"><i class="fas fa-star"></i> 9.2/10 IMDb</span>
                    </div>
                    <h1 class="movie-title">DUNE: <span class="highlight">PART TWO</span></h1>
                    <p class="movie-description">Paul Atreides unites with Chani and the Fremen while on a warpath of revenge against the conspirators who destroyed his family.</p>
                    <div class="hero-buttons">
                        <button class="btn btn-primary"><i class="fas fa-ticket"></i> Book Tickets</button>
                        <button class="btn btn-secondary"><i class="fas fa-play"></i> Watch Trailer</button>
                    </div>
                </div>
            </li>
            <!-- Slide 2: Civil War -->
            <li class="carousel-slide" data-bg="assets/hero_bg_civil_war.png">
                <div class="slide-overlay"></div>
                <div class="slide-content">
                    <div class="badge-container">
                        <span class="badge">New Release</span>
                        <span class="rating"><i class="fas fa-star"></i> 8.8/10 IMDb</span>
                    </div>
                    <h1 class="movie-title">CIVIL <span class="highlight">WAR</span></h1>
                    <p class="movie-description">
                        A journey across a dystopian future America, following a team of military-embedded journalists as they race against time to reach DC.
                    </p>
                    <div class="hero-buttons">
                        <button class="btn btn-primary"><i class="fas fa-ticket"></i> Book Tickets</button>
                        <button class="btn btn-secondary"><i class="fas fa-play"></i> Watch Trailer</button>
                    </div>
                </div>
            </li>
            <!-- Slide 3: Cyber Odyssey -->
            <li class="carousel-slide" data-bg="assets/hero_bg_cyber_odyssey.png">
                <div class="slide-overlay"></div>
                <div class="slide-content">
                    <div class="badge-container">
                        <span class="badge">Trending</span>
                        <span class="rating"><i class="fas fa-star"></i> 9.1/10 IMDb</span>
                    </div>
                    <h1 class="movie-title">CYBER <span class="highlight">ODYSSEY</span></h1>
                    <p class="movie-description">
                        In a neon-soaked future, a lone hacker uncovers a conspiracy that threatens the very fabric of reality itself.
                    </p>
                    <div class="hero-buttons">
                        <button class="btn btn-primary"><i class="fas fa-ticket"></i> Book Tickets</button>
                        <button class="btn btn-secondary"><i class="fas fa-play"></i> Watch Trailer</button>
                    </div>
                </div>
            </li>
        </ul>
    </div>

    <button class="carousel-button carousel-button--left is-hidden">
        <i class="fas fa-chevron-left"></i>
    </button>
    <button class="carousel-button carousel-button--right">
        <i class="fas fa-chevron-right"></i>
    </button>

    <div class="carousel-nav">
        <button class="carousel-indicator current-slide"></button>
        <button class="carousel-indicator"></button>
        <button class="carousel-indicator"></button>
    </div>

    <!-- Scroll Indicator -->
    <div class="scroll-indicator">
        <i class="fas fa-chevron-down"></i>
    </div>
</section>

<!-- Search Bar (Floating) -->
<div class="search-container">
    <div class="search-bar">
        <i class="fas fa-search search-icon"></i>
        <input type="text" name="SearchQuery" placeholder="Search movies, cinemas, or genres...">
        <button class="btn btn-primary" style="padding: 0.5rem 1.5rem; margin-right: 1rem;">Now Showing</button>
        <div class="search-filters">
            <a href="#">Coming Soon</a>
            <a href="#"><i class="fas fa-square"></i> IMAX</a>
            <a href="#"><i class="fas fa-volume-up"></i> Dolby</a>
        </div>
    </div>
</div>

<!-- Trending Now Section -->
<section class="section now-showing reveal-up">
    <div class="section-header">
        <div>
            <h2 class="section-title">Trending Now</h2>
            <p class="section-subtitle">Top picks for you this week</p>
        </div>
        <a href="#" class="view-all">View All <i class="fas fa-arrow-right"></i></a>
    </div>

    <div class="movie-grid">
        <!-- Card 1: Civil War -->
        <div class="movie-card">
            <div class="card-image">
                <!-- BG image set in CSS nth-child(1) -->
                <div class="card-overlay">
                    <span class="genre">ACTION</span>
                    <span class="rating"><i class="fas fa-star"></i> 8.8</span>
                </div>
            </div>
            <div class="card-info">
                <h3>Civil War</h3>
                <p>2h 15m • English</p>
                <button class="btn-block">Book Now</button>
            </div>
        </div>

        <!-- Card 2: Cyber Odyssey -->
        <div class="movie-card">
            <div class="card-image">
                <!-- BG image set in CSS nth-child(2) -->
                <div class="card-overlay">
                    <span class="genre">SCI-FI</span>
                    <span class="rating"><i class="fas fa-star"></i> 9.1</span>
                </div>
            </div>
            <div class="card-info">
                <h3>Cyber Odyssey</h3>
                <p>2h 45m • English</p>
                <button class="btn-block">Book Now</button>
            </div>
        </div>

        <!-- Card 3: The Whispering -->
        <div class="movie-card">
            <div class="card-image">
                <!-- BG image set in CSS nth-child(3) -->
                <div class="card-overlay">
                    <span class="genre">HORROR</span>
                    <span class="rating"><i class="fas fa-star"></i> 7.9</span>
                </div>
            </div>
            <div class="card-info">
                <h3>The Whispering</h3>
                <p>1h 50m • English</p>
                <button class="btn-block">Book Now</button>
            </div>
        </div>

        <!-- Card 4: Last Sunset -->
        <div class="movie-card">
            <div class="card-image">
                <!-- BG image set in CSS nth-child(4) -->
                <div class="card-overlay">
                    <span class="genre">DRAMA</span>
                    <span class="rating"><i class="fas fa-star"></i> 8.5</span>
                </div>
            </div>
            <div class="card-info">
                <h3>Last Sunset</h3>
                <p>2h 10m • English</p>
                <button class="btn-block">Book Now</button>
            </div>
        </div>
    </div>
</section>

<!-- Experience Section -->
<section class="section experience-section reveal-up">
    <div class="experience-image">
        <div class="image-wrapper">
            <img src="assets/luxury_recliners.png" alt="Luxury Recliners">
        </div>
        <div class="image-caption">
            <span class="badge-red">PREMIUM</span>
            <h3>Luxury Recliners</h3>
        </div>
    </div>
    <div class="experience-content">
        <h2>Immerse Yourself in the <span class="highlight">Ultimate Experience</span></h2>
        <p>Discover a new standard of cinema with our state-of-the-art theaters. From crystal clear IMAX projection to the earth-shattering sound of Dolby Atmos.</p>
        <div class="features-grid">
            <div class="feature-card">
                <i class="fas fa-volume-up feature-icon"></i>
                <h4>Dolby Atmos</h4>
                <p>360° Sound Immersion</p>
            </div>
            <div class="feature-card">
                <i class="fas fa-video feature-icon"></i>
                <h4>Laser Projection</h4>
                <p>Crystal Clear 4K</p>
            </div>
            <div class="feature-card">
                <i class="fas fa-couch feature-icon"></i>
                <h4>VIP Comfort</h4>
                <p>Full Recliners & Service</p>
            </div>
            <div class="feature-card">
                <i class="fas fa-utensils feature-icon"></i>
                <h4>Gourmet Dining</h4>
                <p>In-Seat Delivery</p>
            </div>
        </div>
    </div>
</section>

<!-- Club Banner Section -->
<section class="section club-banner-section reveal-up">
    <div class="club-banner">
        <div class="club-content">
            <h2>Join the FlickIt Club</h2>
            <p>Get 50% off your first ticket, free popcorn upgrades, and exclusive access to premiere screenings.</p>
            <div class="club-actions">
                <button class="btn btn-white">Get Started Free</button>
                <button class="btn btn-outline-white">Learn More</button>
            </div>
        </div>
        <div class="club-visual">
            <i class="fas fa-ticket-alt"></i>
        </div>
    </div>
</section>

<script src="~/js/Home.js"></script>