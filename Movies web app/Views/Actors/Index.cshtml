@using Business.DTOs.Actors
@model List<GetAllActorsDto>
@{
    ViewData["Title"] = "Actors";

    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/Actor.css" asp-append-version="true" />

<section class="actors-hero">
    <div class="hero-content">
        <h1>Meet the Stars</h1>
        <p>Discover the talented cast and crew behind your favorite blockbusters.</p>

        <div class="actor-search-container">
                <form asp-controller="Actors" asp-action="Index" method="get" class="actor-search">

                    <i class="fas fa-search"></i>

                    <input type="text"
                       name="searchString"
                           value="@ViewData["CurrentFilter"]"
                           placeholder="Search actors by name..." />

                    <button type="submit" class="btn-search">Search</button>

                </form>

        </div>
    </div>
</section>

<!-- Actors List Section -->
<section class="actors-section">
    <div class="actors-header">
        <div class="header-title">
            <h2>All Actors</h2>
            <span class="count-badge">@Model.Count</span>
        </div>
        <!-- Admin Action (Visual Only) -->
        <div class="view-controls" data-target="directorsGrid" data-storage-key="directorsViewMode">
            <button class="view-btn active" data-view="grid" title="Grid View"><i class="fas fa-th"></i></button>
            <button class="view-btn" data-view="list" title="List View"><i class="fas fa-list"></i></button>
            <!-- Admin Action (Visual Only) -->
            <a asp-controller="Actors" asp-action="Create" class="btn btn-primary" style="margin-left: 1rem;"><i class="fas fa-plus"></i> Add New Director</a>
        </div>
    </div>

    <div class="actors-grid" id="directorsGrid">
        <!-- Card 1: Christopher Nolan -->
        @foreach (var actor in Model)
        {

            <div class="actor-card">
                <div class="actor-image-wrapper">
                    <!-- Placeholder -->
                    <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#555;">
                        <img src="@actor.ProfilePath" alt="@actor.FullName" class="actor-image" onerror="this.src='https://via.placeholder.com/150/111/fff?text=RDJ'">
                    </div>

                    @* <div class="rank-badge">#1</div> *@
                </div>
                <h3>@actor.FullName</h3>
                <p>@actor.Bio</p>
                <div class="actor-actions">
                    <a asp-controller="Actors" asp-action="Details" asp-route-id="@actor.Id" class="btn-view-details">View Details <i class="fas fa-arrow-right"></i></a>
                    <div class="action-icons">
                        <a asp-controller="Actors" asp-action="Edit" asp-route-id="@actor.Id" class="action-icon-btn"><i class="fas fa-pen"></i></a>
                        <form asp-controller="Actors" asp-action="Delete" asp-route-id="@actor.Id" method="post" onscroll="return confirm('Are you sure you want to delete this actor @actor.FullName?')">
                            <button type="submit" class="action-icon-btn delete"><i class="fas fa-trash"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.Count > 8)
    {
        
    <div class="pagination">
        <button class="page-arrow"><i class="fas fa-chevron-left"></i></button>
        <a href="#" class="page-link active">1</a>
        <a href="#" class="page-link">2</a>
        <a href="#" class="page-link">3</a>
        <span style="color: grey;">...</span>
        <a href="#" class="page-link">12</a>
        <button class="page-arrow"><i class="fas fa-chevron-right"></i></button>
    </div>
    }
</section>

@* <!-- @RenderBody() End --> *@

    <script src="~/js/view-toggle.js" asp-append-version="true"></script>