@using Business.DTOs.Actors
@model GetActorByIdDto

@{
    Layout = "_Layout";
    ViewData["Title"] = Model.FullName;
}
<link href="~/css/Actor.css" rel="stylesheet" />
<div class="actor-details-container">
    <!-- Breadcrumb -->
    <div class="breadcrumb">
        <a asp-action="index" asp-controller="Home">Home</a> <pre> > </pre> 
        <a asp-action="index" asp-controller="Actors" class="breadcrumb-label">Actors</a><pre> > </pre>
        <span>@Model.FullName</span>
    </div>

    <!-- Profile Card -->
    <div class="profile-card">
        <div class="profile-image">
            <!-- Placeholder using a div, normally an img -->
            <div style="width: 100%; height: 100%; background: #222; display: flex; align-items: center; justify-content: center; color: #555;">
                <img src="@Model.ProfilePath" alt="Profile Image" style="max-width: 100%; max-height: 100%;">
            </div>
        </div>

        <div class="profile-info">
            <div class="profile-header">
                <h1>@Model.FullName</h1>
                <div class="admin-controls">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-admin-edit"><i class="fas fa-pen"></i> Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-admin-delete"><i class="fas fa-trash"></i> Delete</a>
                </div>
            </div>

            <div class="profile-meta">
                <span><i class="fas fa-birthday-cake"></i> @Model.BirthDate.ToString("yyyy-MM-dd") -(@(DateTime.Now.Year - Model.BirthDate.Year) years)  </span>
                <span class="meta-dot"></span>
            </div>

            <div class="profile-bio">
                <p>@Model.Bio</p>
            </div>

            @* <div class="stats-grid">
                <div class="stat-item">
                    <span class="stat-label">KNOWN CREDITS</span>
                    <span class="stat-value">108</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">CAREER START</span>
                    <span class="stat-value">1984</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">NATIONALITY</span>
                    <span class="stat-value">Canadian</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">AWARDS</span>
                    <span class="stat-value">14 Wins</span>
                </div>
            </div> *@
        </div>
    </div>

    <!-- Filmography Section -->
    <div class="filmography-section">
        @if (Model.MovieDetails.Count > 0)
        {
        <div class="section-header-custom">
            <div class="title-with-bar">
                <h2>Appears In</h2>
            </div>
            <a href="#" class="view-all-link">View Full Filmography <i class="fas fa-arrow-right"></i></a>
        </div>
            
        <div class="movies-grid-responsive">
            <!-- Movie 1 -->
            @foreach (var movie in Model.MovieDetails)
            {
                
             <div class="movie-card-vertical">
                <div class="poster-wrapper">
                    <img src="@movie.PosterUrl" alt="@movie.Name" style="background: #333;">
                    @* <div class="poster-badge">@movie.</div> *@
                </div>
                <div class="movie-details">
                    <h3>@movie.Name</h3>
                    @* <p>as John Wick</p> *@
                </div>
            </div>
            }
        </div>
        }
    </div>
</div>

