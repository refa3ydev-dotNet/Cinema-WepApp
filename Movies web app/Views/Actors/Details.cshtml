@using Business.DTOs.Actors
@model GetActorByIdDto

@{
    Layout = "_Layout";
    ViewData["Title"] = Model.FullName;
}
<link href="~/css/Actor.css" rel="stylesheet" />


        
        <!-- Modern Backdrop -->
        <div class="actor-details-hero-backdrop">
            <!-- @Model.ProfilePath (blurred) -->
            <img src="assets/poster_civil_war.png" alt="Backdrop" class="hero-backdrop-img"> 
        </div>

        <div class="actor-details-container">
            <!-- Breadcrumb -->
            <div class="breadcrumb">
                <a asp-controller="Home" asp-action="Index">Home</a> <i class="fas fa-chevron-right" style="font-size: 0.7rem; margin: 0 0.5rem;"></i>
                <a asp-controller="Actors" asp-action="Index">Actors</a> <i class="fas fa-chevron-right" style="font-size: 0.7rem; margin: 0 0.5rem;"></i>
                <span>@Model.FullName</span>
            </div>

            <!-- Profile Card -->
            <div class="profile-card">
                <div class="profile-image">
                    <!-- Placeholder using a div, normally an img -->
                    <div style="width: 100%; height: 100%; background: #222; display: flex; align-items: center; justify-content: center; color: #555;">
                        <img src="@Model.ProfilePath" style="transition: all 0.3s ease-in-out;" alt="Alternate Text" />
                    </div>
                </div>

                <div class="profile-info">
                    <div class="profile-header">
                        <!-- @Model.FullName -->
                        <h1>@Model.FullName</h1>
                        <div class="admin-controls">
                            <a asp-controller="Actors" asp-action="Edit" asp-route-id="@Model.Id" class="btn-admin-edit" style="text-decoration: none;"><i class="fas fa-pen"></i> Edit</a>
                            <form asp-controller="Actors" asp-action="Delete" asp-route-id="@Model.Id" method="post">
                            <button type="button" class="btn-admin-delete"><i class="fas fa-trash"></i> Delete</button>
                                </form>
                        </div>
                    </div>

                    <div class="profile-meta">
                @if (Model.DeathDate!=null)
                {
                        <span><i class="fas fa-birthday-cake"></i> @Model.BirthDate.ToString("MM/dd/yyyy") - <i class="fas fa-skull"></i> Died: @Model.DeathDate.Value.ToString("MM/dd/yyyy") (@Model.Age)</span>
                    
                }
                else
                {

                        <span><i class="fas fa-birthday-cake"></i> @Model.BirthDate.ToString("MM/dd/yyyy") - (@Model.Age)</span>
                }
                <!-- @Model.BirthDate -->
                        <span class="meta-dot"></span>
                        <!-- @Model.Nationality -->
                        <span><i class="fas fa-flag"></i> @Model.Nationality</span>
                        <span class="meta-dot"></span>
                        <!-- @Model.DeathDate (Conditional: if (Model.DeathDate.HasValue)) -->
                        <!-- <span class="meta-dot"></span> -->
                        
                        <!-- @Model.IMDBLink -->
                        <a href="@Model.IMDBLink" target="_blank" class="meta-link"><i class="fab fa-imdb"></i> IMDb Profile</a>
                    </div>

                    <div class="profile-bio">
                        <!-- @Model.Bio -->
                        @Model.Bio
                    </div>

                    <div class="stats-grid">
                        <div class="stat-item">
                    @if (Model.DeathDate.HasValue)
                    {

                        <span class="stat-label">Death Age</span>
                            <span class="stat-value">@(Model.DeathDate.Value.Year - Model.BirthDate.Year)</span>
                    }
                    else
                    {
                    <span class="stat-label">Age</span>
                            <span class="stat-value">@Model.Age</span>
                    }
                    <!-- Derived from Model.MovieDetails.Count -->
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">NATIONALITY</span>
                            <!-- @Model.Nationality -->
                            <span class="stat-value">@Model.Nationality</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filmography Section -->
    @if(Model.MovieDetails.Count > 0) { 
    <div class="filmography-section">
                <div class="section-header-custom">
                    <div class="title-with-bar">
                        <h2>Appears In</h2>
                    </div>
                    <a href="#" class="view-all-link">View Full Filmography <i class="fas fa-arrow-right"></i></a>
                </div>

                <div class="movies-grid-responsive">
                @foreach (var movie in Model.MovieDetails)
                {
                    
                <!-- Movie Card -->
                    <div class="movie-card-vertical">
                        <div class="poster-wrapper">
                            @* <!-- @movie.PosterPath --> *@
                            <img src="@movie.PosterUrl" alt="John Wick" style="background: #333;">
                            <div class="poster-badge">8.5</div>
                        </div>
                        <div class="movie-details">
                            @* <!-- @movie.Title --> *@
                            <h3>@movie.Name</h3>
                        </div>
                    </div>
                }
                </div>
            </div>
    }
        </div>