@using Business.DTOs.Actors
@model CreateActorDto

@{
    ViewData["Title"] = "Create New Actor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row text">
    <div class="col-md-8 offset-2">
        <h1 class="text-white">
            Add a New Actor
        </h1>
    </div>
    <div class="col-md-8 offset-2">

        <form asp-action="Create" method="post" enctype="multipart/form-data" class="gap-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group text-center mb-3">
                <img id="ProfilePicturePreview" style="max-width: 200px; height: auto;" />
                <p class="Actor-Name mt-3" id="actorName" style="color:white; font-size:1.5rem; font-weight:bold;"></p>
            </div>
            <div class="form-group text-white mb-3">
                <label asp-for="ProfilePicture" class="control-label">Profile </label>
                <input asp-for="ProfilePicture" class="form-control" id="ProfilePicture" placeholder="" type="file" />
                <span asp-validation-for="ProfilePicture" class="text-danger"></span>
            </div>
            <div class="form-group text-white mb-3">
                <label asp-for="FullName" class="control-label ">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="Enter actor Full Name" id="FullName" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="form-group text-white mb-3">
                <label asp-for="Bio" class="control-label">Biography</label>
                <input asp-for="Bio" class="form-control" placeholder="Enter Biography" id="Bio" />
                <span asp-validation-for="Bio" class="text-danger"></span>
            </div>
            <div class="form-group text-white mb-3">
                <label asp-for="IMDBLink" class="control-label">IMDB Link</label>
                <input asp-for="IMDBLink" class="form-control" placeholder="Enter IMDB link" id="IMDBLink" />
                <span asp-validation-for="IMDBLink" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-between mb-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                <input type="submit" value="Create" class="btn btn-outline-success" />
            </div>
        </form>
    </div>


</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Add the following code if you want the name of the file appear on select
        $(".custom-file-input").on("change", function () {
            var fileName = $(this).val().split("\\").pop();
            $(this).siblings(".custom-file-label").addClass("selected").html(fileName);
        });
    </script>
    <script>

        $("#ProfilePicture").on("change", function () {
            const [file] = this.files;
            if (file) {
                const output = document.getElementById("ProfilePicturePreview");
                output.src = URL.createObjectURL(file);
            }
        });
    </script>
    <script>
        actorNameTag=document.getElementById("actorName");
        inputNameTag=document.getElementById("FullName");
        window.onchange=function(){
        actorNameTag.innerHTML=inputNameTag.value;
        }
    </script>

        }