@using Business.DTOs.Actors
@model CreateActorDto

@{
    ViewData["Title"] = "Create New Actor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/Actor.css">

<div class="create-actor-container">
    <div class="breadcrumb">
        Dashboard / <a href="actors.html" style="color:var(--text-grey);">Actors</a> / <span>Create New</span>
    </div>

    <h1 class="page-title">Cast a New Actor</h1>
    <p class="page-subtitle">Add a new talent profile to the database. Ensure all information is verified.</p>

    <form asp-action="Create" method="post" class="admin-form-card" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <!-- Left: Upload Section -->
        <div class="upload-section">
            <h3>Profile Headshot</h3>
            <!-- Hidden File Input -->
            <input asp-for="ProfilePicture" type="file" id="headshotUpload" accept="image/*" hidden>

            <div class="upload-circle" id="uploadTrigger">
                <img id="uploadPreview" src="" alt="Preview" style="display:none; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; position: absolute; z-index: 1;">
                <div class="upload-placeholder" style="display: flex; flex-direction: column; align-items: center; z-index: 0;">
                    <i class="fas fa-camera upload-icon"></i>
                    <span style="font-size: 0.8rem; letter-spacing: 1px;">UPLOAD</span>
                </div>
                <div class="upload-btn-round" style="z-index: 2;"><i class="fas fa-pen"></i></div>
            </div>
            <p class="upload-hint">
                Recommended: High resolution JPG/PNG. Min 500x500px. Max 5MB.
            </p>
        </div>

        <!-- Right: Form Fields -->
        <div class="form-section">
            <!-- Full Name -->
            <div class="admin-form-group">
                <label asp-for="FullName">Full Name <span class="required">*</span></label>
                <div style="position: relative;">
                    <i class="fas fa-user" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: #666;"></i>
                    <input asp-for="FullName" type="text" class="admin-input" placeholder="Enter actor Full Name" style="padding-left: 2.5rem;" required name="FullName">
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
            </div>

            <!-- Biography -->
            <div class="admin-form-group">
                <div style="display: flex; justify-content: space-between;">
                    <label asp-for="Bio">Biography</label>
                    <span style="font-size: 0.8rem; color: #666;">0/500</span>
                </div>
                <textarea asp-for="Bio" class="admin-input" rows="6" placeholder="Enter a brief biography of the actor, focusing on major achievements and style..."></textarea>
                    <span asp-validation-for="Bio" class="text-danger"></span>
            </div>

            <!-- Row: Birth Date & Nationality -->
            <div class="form-row">
                <div class="admin-form-group">
                    <label asp-for="BirthDate">Birth Date</label>
                    <div style="position: relative;">
                        <i class="fas fa-calendar" style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); color: #666;"></i>
                        <input asp-for="BirthDate" type="text" class="admin-input" placeholder="mm/dd/yyyy" onfocus="(this.type='date')" >
                    <span asp-validation-for="BirthDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="admin-form-group">
                    <label asp-for="IMDBLink">IDMPLink</label>
                    <div style="position: relative;">
                        <i class="fas fa-globe" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: #666;"></i>
                        <input asp-for="IMDBLink" type="text" class="admin-input" placeholder="IMDB link" style="padding-left: 2.5rem;" >
                        <span asp-validation-for="IMDBLink" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="form-actions">
                <a asp-action="Index" class="btn btn-cancel" onclick="window.location.href='actors.html'">Back to List</a>
                <input type="submit" value="Create" class="btn btn-primary" style="padding: 0.8rem 2rem;">
            </div>
        </div>
    </form>
</div>

                    <script src="~/js/create-actor.js"></script>