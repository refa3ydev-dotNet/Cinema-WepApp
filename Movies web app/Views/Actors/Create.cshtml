@using Business.DTOs.Actors
@model CreateActorDto

@{
    ViewData["Title"] = "Create New Actor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/Director/Director.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/Actor.css" asp-append-version="true">


<div class="admin-container mt-5">
    <div class="admin-breadcrumb">
        <a asp-controller="Home" asp-action="Index" > Home</a> /<a asp-controller="Actors" asp-action="Index">Actors</a> / <span style="color:white; font-weight:600;">Create</span>
    </div>

    <h1 style="font-size: 2.2rem; margin-bottom: 0.5rem;">Add New Actor</h1>
    <p style="color: #888; font-size: 1rem;">Enter the details below to add a new actor to the cinema database.</p>

    <!-- Form Card -->
    <form asp-controller="Actors" asp-action="Create" enctype="multipart/form-data" method="post" class="create-director-card">
        <!-- Profile Image Row -->
        <div class="upload-row">
            <div class="dashed-upload-circle">
                <i class="fas fa-user-circle" style="font-size: 3rem; color: rgba(255,255,255,0.2);"></i>
            </div>
            <div class="upload-info">
                <h4>Profile Headshot</h4>
                <p>Upload a high-quality headshot. Max size 5MB.</p>
                <div class="file-btn-group" id="fileUploadGroup">
                    <input asp-for="ProfilePicture" type="file" id="ActorImage" hidden accept="image/*"> <!-- Kept name DirectorImage if backend needs it, or change to ActorImage/ProfilePicture -->
                    <button type="button" class="btn-choose-file" onclick="document.getElementById('ActorImage').click()">
                        <i class="fas fa-cloud-upload-alt"></i> Choose File
                    </button>
                    <span style="color: #666; font-size: 0.9rem;">or</span>
                    <button type="button" class="btn-text" id="btnSwitchToUrl">Use URL</button>
                </div>

                <div class="url-input-group" id="urlInputGroup" style="display: none;">
                    <input asp-for="ProfilePath" type="url" id="ActorImageUrl" class="input-custom" placeholder="Paste direct image link (ends in .jpg, .png)" style="width: 100%;">
                    <button type="button" class="btn-text" id="btnSwitchToFile" style="margin-left: 0.5rem; white-space: nowrap;">Cancel</button>
                </div>

                <div style="margin-top: 0.5rem;">
                    <a href="#" class="remove-link">Remove Image</a>
                </div>
            </div>
        </div>

        <!-- Full Name -->
        <div class="form-group-custom">
            <label asp-for="FullName">Full Name</label>
            <div class="input-with-icon">
                <i class="fas fa-user"></i>
                <input asp-for="FullName" type="text" id="Name"  class="input-custom" placeholder="e.g. Robert De Niro">
            </div>
        </div>

        <!-- Biography -->
        <div class="form-group-custom">
            <label asp-for="Bio">Biography</label>
            <div class="input-with-icon" style="align-items: flex-start;">
                <i class="fas fa-file-alt" style="top: 1.5rem;"></i>
                <textarea asp-for="Bio" id="Biography" rows="5" class="textarea-custom" placeholder="Write a brief biography describing the actor's career and style..."></textarea>
            </div>
            <div class="char-count">0/500 characters</div>
        </div>

        <!-- Row: Birth Date, Nationality, IMDb -->
        <div class="form-row" style="display: flex; gap: 1rem; flex-wrap: wrap;">

            <!-- Birth Date -->
            <div class="form-group-custom" style="flex: 1; min-width: 200px;">
                <label asp-for="BirthDate">Birth Date</label>
                <div class="input-with-icon">
                    <i class="fas fa-calendar"></i>
                    <input asp-for="BirthDate" type="date" id="BirthDate" class="input-custom">
                </div>
            </div>

            <!-- Deceased Checkbox & Death Date -->
            <div class="form-group-custom" style="flex: 1; min-width: 200px;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.8rem;">
                    <label for="IsDeceased" style="margin-bottom: 0; cursor: pointer;">
                        <input type="checkbox" id="IsDeceased" name="IsDeceased" style="accent-color: var(--primary-red);">
                        Deceased?
                    </label>
                </div>

                <div class="input-with-icon" id="DeathDateGroup" style="display: none;">
                    <i class="fas fa-skull"></i>
                    <input asp-for="DeathDate" type="date" id="DeathDate" class="input-custom" placeholder="Death Date">
                </div>
            </div>

            <!-- Nationality -->
            <div class="form-group-custom" style="flex: 1; min-width: 200px;">
                <label asp-for="Nationality">Nationality</label>
                <div class="input-with-icon">
                    <i class="fas fa-globe"></i>
                    <select asp-for="Nationality" id="Nationality" class="input-custom">
                        <option value="" disabled selected>Select a country</option>
                        <!-- Populated via API -->
                    </select>
                </div>
            </div>

            <!-- IMDb Link -->
            <div class="form-group-custom" style="flex: 1; min-width: 200px;">
                <label asp-for="IMDBLink">IMDb Profile</label>
                <div class="input-with-icon">
                    <i class="fab fa-imdb"></i>
                    <input asp-for="IMDBLink" type="url" id="IMDB" class="input-custom" placeholder="https://imdb.com/name/nm...">
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="action-footer">
            <button type="button" class="btn btn-secondary" style="border:1px solid #333; background:transparent;" onclick="window.location.href='actors.html'">Cancel</button>
            <button type="submit" class="btn btn-primary">Create Actor</button>
        </div>

    </form>
</div>

                    <script src="~/js/create-actor.js"></script>