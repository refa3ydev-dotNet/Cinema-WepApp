@using Business.DTOs.Producers
@model UpdateProducerDto

@{
    ViewData["Title"] = "Edit Producer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row text">
    <div class="col-md-8 offset-2">
        <h1 class="text-white">
            Edit Producer
        </h1>
    </div>
    <div class="col-md-8 offset-2">

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group text-center">
                <img id="ProfilePicturePreview" src="@Model.ProfilePath" style="max-width: 200px; height: auto;" />
            </div>
            <div class="form-group text-white">
                <label asp-for="ProfilePicture" class="control-label">Profile </label>
                <input asp-for="ProfilePicture" class="form-control" id="ProfilePictureURL" placeholder="" type="file" />
                <span asp-validation-for="ProfilePicture" class="text-danger"></span>
            </div>
            <div class="form-group text-white">
                <label asp-for="FullName" class="control-label">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="form-group text-white">
                <label asp-for="Bio" class="control-label">Biography</label>
                <input asp-for="Bio" class="form-control" placeholder="" />
                <span asp-validation-for="Bio" class="text-danger"></span>
            </div>
            <div class="form-group text-white">
                <label asp-for="IMDBLink" class="control-label">Biography</label>
                <input asp-for="IMDBLink" class="form-control" placeholder="" />
                <span asp-validation-for="IMDBLink" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-between mb-2 mt-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                <input type="submit" value="Update" class="btn btn-outline-success" />
            </div>
            <input type="hidden" asp-for="ProfilePath" />
            <input type="hidden" asp-for="Id" />
        </form>
    </div>


</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Add the following code if you want the name of the file appear on select
        $(".custom-file-input").on("change", function () {
            var fileName = $(this).val().split("\\").pop();
            $(this).siblings(".custom-file-label").addClass("selected").html(fileName);
        });
    </script>
    <script>

        $("#ProfilePictureURL").on("change", function () {
            const [file] = this.files;
            if (file) {
                const output = document.getElementById("ProfilePicturePreview");
                output.src = URL.createObjectURL(file);
            }
        });
    </script>

        }