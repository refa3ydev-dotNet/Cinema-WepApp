@using System.Security.Claims
@{
    var FirstName = User.FindFirst("FirstName")?.Value??"user";
    var LastName = User.FindFirst("LastName")?.Value??"user";
    var ProfilePicture = User.FindFirst("ProfilePicture")?.Value??"/Images/Male.png";
}
@functions {
    public string IsActive(string controller, string action)
    {
        var routeData = ViewContext.RouteData.Values;
        var currentController = routeData["controller"] as string;
        var currentAction = routeData["action"] as string;

        var isActive = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
                       string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

        return isActive ? "active" : "";
    }
}
