@functions {
    public string IsActive(string controller, string action)
    {
        var routeData = ViewContext.RouteData.Values;
        var currentController = routeData["controller"] as string;
        var currentAction = routeData["action"] as string;

        var isActive = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
                       string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

        return isActive ? "active" : "";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Z Cinema</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href='~/Images/logo.png's rel="icon" />
</head>
<body>
    <!-- Navbar -->
    <header class="main-header">
        <div class="logo">
            <a class="d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/Images/logo.png" alt="ZCinema" width="40"/> ZCINEMA</a>
        </div>
            <div class="mobile-menu-toggle">
                <i class="fas fa-bars"></i>
            </div>

            <!-- Header Search Bar -->
            <div class="header-search">
                <i class="fas fa-search"></i>
                <input type="text" name="SearchQuery" placeholder="Search movies, cinemas...">
            </div>

            <nav class="main-nav">
            <a class="nav-link @IsActive("Home", "Index")"
               asp-controller="Home" asp-action="Index">
                Home
            </a>

            <a class="nav-link @IsActive("Movies", "Index")"
               asp-controller="Movies" asp-action="Index">
                Movies
            </a>

            <a class="nav-link @IsActive("Cinemas", "Index")"
               asp-controller="Cinemas" asp-action="Index">
                Cinemas
            </a>

            <a class="nav-link @IsActive("Actors", "Index")"
               asp-controller="Actors" asp-action="Index">
                Actors
            </a>

            <a class="nav-link @IsActive("Directors", "Index")"
               asp-controller="Directors" asp-action="Index">
                Directors
            </a>
                <!-- Mobile Only Actions -->
                <div class="mobile-nav-actions">
                    <a href="login.html" class="login-link">Login</a>
                    <a href="register.html" class="btn btn-primary">Sign Up</a>
                </div>
            </nav>
            <div class="header-actions">
                <a href="login.html" class="login-link">Login</a>
                <a href="register.html" class="btn btn-primary">Sign Up</a>
            </div>
        
    </header>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>


    <footer class="main-footer">
        <div class="footer-content">
            <div class="footer-brand">
                <div class="logo">
                    <i class="fas fa-ticket-alt"></i> CINEPLEX
                </div>
                <p>Experience the magic of movies in the most immersive way possible. Comfort, technology, and service combined.</p>
                <div class="social-links">
                    <a href="#"><i class="fab fa-discord"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                </div>
            </div>
            <div class="footer-links">
                <div class="link-column">
                    <h4>Movies</h4>
                    <a href="#">Now Showing</a>
                    <a href="#">Coming Soon</a>
                    <a href="#">Box Office</a>
                    <a href="#">IMAX Experience</a>
                </div>
                <div class="link-column">
                    <h4>Cinemas</h4>
                    <a href="#">Find a Cinema</a>
                    <a href="#">Experiences</a>
                    <a href="#">Food & Drinks</a>
                    <a href="#">Private Screenings</a>
                </div>
                <div class="link-column">
                    <h4>Support</h4>
                    <a href="#">Help Center</a>
                    <a href="#">Contact Us</a>
                    <a href="#">Privacy Policy</a>
                    <a href="#">Terms of Service</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2024 Cineplex Inc. All rights reserved.</p>
            <div class="footer-meta">
                <span>English (US)</span>
                <span>USD</span>
            </div>
        </div>
    </footer>

    <!-- Script Dependencies -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- @await RenderSectionAsync("Scripts", required: false) -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/view-toggle.js" asp-append-version="true"></script>
</body>
</html>
