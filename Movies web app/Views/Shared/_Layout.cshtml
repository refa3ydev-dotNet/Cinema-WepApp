                                .text-flick {
                                    font-family: 'Segoe UI', system-ui, sans-serif;
                                    font-weight: 900;
                                    font-size: 58px;
                                    fill: url(#silverGrad);
                                    font-style: italic;
                                    letter-spacing: -1px;
                                }

                                /* تنسيق كلمة It */
                                .text-it {
                                    font-family: 'Segoe UI', system-ui, sans-serif;
                                    font-weight: 900;
                                    font-size: 58px;
                                    fill: url(#redGrad);
                                    font-style: italic;
                                }

                                /* الخط مخفي في الوضع الطبيعي */
                                .swoosh {
                                    stroke-dasharray: 400;
                                    stroke-dashoffset: 400;
                                    opacity: 0;
                                }

                                /* تفعيل حركة الخط فقط عند التمرير (Hover) */
                                svg:hover .swoosh {
                                    animation: flickAnim 1.5s cubic-bezier(0.25, 1, 0.5, 1) forwards;
                                }

                                /* أنيميشن الأيقونة الطافية مستمر بهدوء */
