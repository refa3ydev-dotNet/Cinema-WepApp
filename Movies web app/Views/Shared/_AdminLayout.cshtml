@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var inferredActivePage = currentController.ToLowerInvariant() switch
    {
        "admin" when string.Equals(currentAction, "PendingRequests", StringComparison.OrdinalIgnoreCase) => "approvals",
        "admin" => "dashboard",
        "cinemas" => "cinemas",
        "movies" => "movies",
        "actors" => "actors",
        "directors" => "directors",
        "producers" => "producers",
        "categories" => "categories",
        "account" => "settings",
        _ => "dashboard"
    };

    var pageTitle = ViewData["AdminPageTitle"]?.ToString() ?? ViewData["Title"]?.ToString() ?? "Dashboard";
    var pageSubtitle = ViewData["AdminPageSubtitle"]?.ToString() ?? "Welcome back. Here's your platform overview.";
    var pageIcon = ViewData["AdminPageIcon"]?.ToString() ?? "fas fa-shield-halved";
    var activePage = ViewData["ActiveAdminPage"]?.ToString() ?? inferredActivePage;

    var activeCinemas = ViewData["ActiveCinemasCount"]?.ToString() ?? "0";
    var pendingApprovals = ViewData["PendingApprovalsCount"]?.ToString() ?? "0";

    var FirstName = User.FindFirst("FirstName")?.Value ?? "user";
    var LastName = User.FindFirst("LastName")?.Value ?? "user";
    var ProfilePicture = User.FindFirst("ProfilePicture")?.Value ?? "/Images/Male.png";

    var adminName = FirstName+" "+LastName;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@pageTitle — Cima Flick Admin Console</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Admin/Dashboard.css" asp-append-version="true" />

</head>

<body>
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">
                <i class="fas fa-clapperboard"></i>
            </div>

            <div class="brand-text">
                <h2>Cinéma Noir</h2>
                <span>Admin Console</span>
            </div>
        </div>

        <nav class="sidebar-nav" id="sidebarNav">
            <div class="nav-group-label">Overview</div>

            <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="nav-item @(activePage == "dashboard" ? "active" : "")"
                   data-page="dashboard">
                <i class="fas fa-th-large"></i>
                <span>Dashboard</span>
            </a>

            <div class="nav-group-label">Management</div>

            <a asp-controller="Cinemas"
                   asp-action="Index"
                   class="nav-item @(activePage == "cinemas" ? "active" : "")"
                   data-page="cinemas">
                <i class="fas fa-building"></i>
                <span>Cinemas</span>
                <span class="nav-badge">@activeCinemas</span>
            </a>

            <a asp-controller="Admin"
                   asp-action="PendingRequests"
                   class="nav-item @(activePage == "approvals" ? "active" : "")"
                   data-page="approvals">
                <i class="fas fa-file-signature"></i>
                <span>Pending Approvals</span>
                <span class="nav-badge badge-warning">@pendingApprovals</span>
            </a>

            <a asp-controller="Movies"
                   asp-action="SearchTmdb"
                   class="nav-item @(activePage == "movies" ? "active" : "")"
                   data-page="movies">
                <i class="fas fa-film"></i>
                <span>Movies</span>
            </a>

            <a asp-controller="Actors"
                   asp-action="Index"
                   class="nav-item @(activePage == "actors" ? "active" : "")"
                   data-page="actors">
                <i class="fas fa-user-group"></i>
                <span>Actors</span>
            </a>

            <a asp-controller="Directors"
                   asp-action="Index"
                   class="nav-item @(activePage == "directors" ? "active" : "")"
                   data-page="directors">
                <i class="fas fa-video"></i>
                <span>Directors</span>
            </a>

            <a asp-controller="Producers"
                   asp-action="Index"
                   class="nav-item @(activePage == "producers" ? "active" : "")"
                   data-page="producers">
                <i class="fas fa-user-tie"></i>
                <span>Producers</span>
            </a>

            <a asp-controller="Categories"
                   asp-action="Index"
                   class="nav-item @(activePage == "categories" ? "active" : "")"
                   data-page="categories">
                <i class="fas fa-tags"></i>
                <span>Categories</span>
            </a>

            <div class="nav-group-label">Platform</div>

            <a asp-controller="Account"
                   asp-action="Profile"
                   class="nav-item @(activePage == "users" ? "active" : "")"
                   data-page="users">
                <i class="fas fa-users"></i>
                <span>Profile</span>
            </a>

            <a asp-controller="Admin"
                   asp-action="Dashboard"
                   asp-fragment="adminCharts"
                   class="nav-item @(activePage == "analytics" ? "active" : "")"
                   data-page="analytics">
                <i class="fas fa-chart-line"></i>
                <span>Analytics</span>
            </a>

            <a asp-controller="Account"
                   asp-action="Profile"
                   class="nav-item @(activePage == "settings" ? "active" : "")"
                   data-page="settings">
                <i class="fas fa-cog"></i>
                <span>Account Settings</span>
            </a>
        </nav>

        <div class="sidebar-profile">
            <img src="@ProfilePicture"
                 alt="Admin"
                 class="profile-avatar">

            <div class="profile-info">
                <div class="profile-name">@adminName</div>
                <div class="profile-role">Super Admin</div>
            </div>

            <button class="profile-menu-btn" id="profileMenuBtn" title="Account menu" type="button">
                <i class="fas fa-ellipsis-vertical"></i>
            </button>
        </div>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <header class="topbar" id="topbar">
        <div class="topbar-left">
            <button class="topbar-toggle" id="sidebarToggle" type="button" aria-label="Toggle sidebar">
                <i class="fas fa-bars"></i>
            </button>
            <div class="topbar-title">
                <h1>
                    <i class="@pageIcon"></i>
                    @pageTitle
                </h1>
                <p class="topbar-subtitle">@pageSubtitle</p>
            </div>
        </div>

        <div class="topbar-right">
            <div class="topbar-search" id="searchBox">
                <i class="fas fa-search"></i>
                <input type="text"
                       placeholder="Search cinemas, movies, users..."
                       id="globalSearch"
                       autocomplete="off">
            </div>

            <a asp-controller="Admin"
               asp-action="PendingRequests"
               class="topbar-icon-btn"
               id="notifBtn"
               title="Pending approvals"
               aria-label="Pending approvals">
                <i class="fas fa-bell"></i>
                @if (pendingApprovals != "0")
                {
                    <span class="notif-dot"></span>
                }
            </a>

            <a asp-controller="Account"
               asp-action="Profile"
               class="topbar-icon-btn"
               id="accountBtn"
               title="Account"
               aria-label="Account">
                <i class="fas fa-user"></i>
            </a>
        </div>
    </header>

    <div class="profile-menu" id="profileMenu" aria-hidden="true">
        <a asp-controller="Account" asp-action="Profile">
            <i class="fas fa-user-gear"></i>
            <span>Profile</span>
        </a>
        <a asp-controller="Admin" asp-action="Dashboard">
            <i class="fas fa-gauge-high"></i>
            <span>Dashboard</span>
        </a>
        <a asp-controller="Account" asp-action="Logout">
            <i class="fas fa-right-from-bracket"></i>
            <span>Logout</span>
        </a>
    </div>

    <main class="main-content">
        <div class="main-inner">
            @RenderBody()
        </div>
    </main>

    @await RenderSectionAsync("AdminVendorScripts", required: false)

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Admin/AdminLayout.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
