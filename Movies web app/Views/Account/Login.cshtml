@model Business.DTOs.Accounts.LoginDto
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}

<div class="auth-right-pane">
<div class="auth-box">
<a href="index.html" class="auth-logo">
<div class="logo">
                    <a class="d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 450 140" width="65%" height="100%">
                            <defs>
                                <linearGradient id="redGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#FF3366" />
                                    <stop offset="100%" stop-color="#E50914" />
                                </linearGradient>

                                <linearGradient id="silverGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#FFFFFF" />
                                    <stop offset="100%" stop-color="#B0B0C5" />
                                </linearGradient>

                                <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                                    <feGaussianBlur stdDeviation="5" result="blur" />
                                    <feComposite in="SourceGraphic" in2="blur" operator="over" />
                                </filter>

                                <mask id="ticketHoles">
                                    <rect x="0" y="0" width="100%" height="100%" fill="white" />
                                    <circle cx="25" cy="67" r="8" fill="black" />
                                    <circle cx="80" cy="67" r="8" fill="black" />
                                </mask>

                            </defs>

                            <style>
                                /* تنسيق كلمة Flick */
                                .text-flick {
                                    font-family: 'Segoe UI', system-ui, sans-serif;
                                    font-weight: 900;
                                    font-size: 58px;
                                    fill: url(#silverGrad);
                                    font-style: italic;
                                    letter-spacing: -1px;
                                }

                                /* تنسيق كلمة It */
                                .text-it {
                                    font-family: 'Segoe UI', system-ui, sans-serif;
                                    font-weight: 900;
                                    font-size: 58px;
                                    fill: url(#redGrad);
                                    font-style: italic;
                                }

                                /* الخط مخفي في الوضع الطبيعي */
                                .swoosh {
                                    stroke-dasharray: 400;
                                    stroke-dashoffset: 400;
                                    opacity: 0;
                                }

                                /* تفعيل حركة الخط فقط عند التمرير (Hover) */
                                svg:hover .swoosh {
                                    animation: flickAnim 1.5s cubic-bezier(0.25, 1, 0.5, 1) forwards;
                                }

                                /* أنيميشن الأيقونة الطافية مستمر بهدوء */
                                .ticket-icon {
                                    transform-origin: 50px 70px;
                                    animation: floatAnim 4s ease-in-out infinite;
                                }

                                @@keyframes flickAnim {
                                    0% {
                                        stroke-dashoffset: 400;
                                        opacity: 0;
                                    }

                                    15% {
                                        opacity: 1;
                                    }

                                    70% {
                                        stroke-dashoffset: 0;
                                        opacity: 1;
                                    }

                                    100% {
                                        stroke-dashoffset: 0;
                                        opacity: 0;
                                    }
                                }

                                @@keyframes floatAnim {
                                    0%, 100% {
                                        transform: translateY(0) rotate(-4deg);
                                    }

                                    50% {
                                        transform: translateY(-6px) rotate(4deg);
                                    }
                                }
                            </style>

                            <g class="ticket-icon">
                                <rect x="25" y="40" width="55" height="55" rx="8" fill="none" stroke="url(#redGrad)" stroke-width="5" mask="url(#ticketHoles)" />
                                <path d="M 42 52 L 65 67 L 42 82 Z" fill="url(#silverGrad)" />
                            </g>

                            <path class="swoosh" d="M 95 105 Q 230 130 380 90" fill="none" stroke="url(#redGrad)" stroke-width="4" stroke-linecap="round" filter="url(#glow)" />

                            <text x="100" y="85" class="text-flick">Cima</text>
                            <text x="240" y="85" class="text-it" filter="url(#glow)">Flick</text>
                        </svg>
                    @if (User.IsInRole("Admin"))
                    {
                        <span class="admin-badge">ADMIN PORTAL</span>
                    }
                    </a>
                </div>
</a>

@if (TempData["ErrorMessage"] != null)
{
<div class="alert alert-danger alert-dismissible fade show" role="alert" style="margin-top: 1rem;">
<i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
}

@if (ViewData.ModelState.Any(x => x.Value.Errors.Any()))
{
<div class="alert alert-danger" role="alert" style="margin-top: 1rem; margin-bottom: 1rem;">
<i class="fas fa-exclamation-triangle"></i>
<ul style="margin: 0.5rem 0 0 1.5rem; padding: 0;">
@foreach (var error in ViewData.ModelState.Where(x => x.Value.Errors.Any()).SelectMany(x => x.Value.Errors))
{
<li>@error.ErrorMessage</li>
}
</ul>
</div>
}

<div class="auth-header" style="text-align: left;">
<h2>Sign in to CimaFlick</h2>
<p>Enter your details below to continue</p>
</div>

<form asp-action="Login" asp-controller="Account" method="post">
            <div class="form-group">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input type="email" class="form-control" id="Email" asp-for="Email" placeholder="you@example.com"
                       required>
                <span asp-validation-for="Email" class="text-danger" style="display:block; margin-top:5px; font-size:0.85em;"></span>
            </div>

            <div class="form-group" style="margin-bottom: 2rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <label asp-for="Password" class="form-label" style="margin-bottom: 0;">Password</label>
                    <a href="#" class="auth-link"
                       style="font-size: 0.85rem; font-weight: 500;">
                        Forgot
                        password?
                    </a>
                </div>
                <div class="password-toggle-wrapper">
                    <input type="password" class="form-control" id="Password" asp-for="Password"
                           placeholder="••••••••" required>
                    <button type="button" class="password-toggle"
                            onclick="togglePasswordVisibility('Password', this)">
                        <i class="far fa-eye"></i>
                    </button>
                </div>
                    <span asp-validation-for="Password" class="text-danger" style="display:block; margin-top:5px; font-size:0.85em;"></span>
            </div>

            <button type="submit" class="btn btn-primary auth-btn">Sign In</button>

            <div style="margin-top: 2rem; text-align: center;">
                <p style="color: #8b949e; font-size: 0.95rem;">
                    New to FlickIt? <a asp-action="Register"
                                        class="auth-link">Create an account</a>
                </p>
            </div>
        </form>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }
</script>
